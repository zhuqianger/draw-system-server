<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.drawsystemserver.mapper.AuctionPickRecordMapper">

    <!--
        选人纪录表建议建表 SQL（需在数据库中手动执行）：

        CREATE TABLE auction_pick_record (
            id BIGINT PRIMARY KEY AUTO_INCREMENT,
            sessionId BIGINT NOT NULL,
            auctionId BIGINT NOT NULL,
            playerId BIGINT NOT NULL,
            teamId BIGINT NOT NULL,
            amount DECIMAL(10,2) NOT NULL,
            sequence INT NOT NULL,
            createTime DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
            KEY idx_session_sequence (sessionId, sequence)
        );
    -->

    <resultMap id="BaseResultMap" type="org.example.drawsystemserver.entity.AuctionPickRecord">
        <id column="id" property="id"/>
        <result column="sessionId" property="sessionId"/>
        <result column="auctionId" property="auctionId"/>
        <result column="playerId" property="playerId"/>
        <result column="teamId" property="teamId"/>
        <result column="amount" property="amount"/>
        <result column="sequence" property="sequence"/>
        <result column="createTime" property="createTime"/>
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM auction_pick_record WHERE id = #{id}
    </select>

    <select id="selectBySessionIdOrderBySequence" resultMap="BaseResultMap">
        SELECT * FROM auction_pick_record
        WHERE sessionId = #{sessionId}
        ORDER BY sequence ASC, id ASC
    </select>

    <select id="selectMaxSequenceBySessionId" resultType="java.lang.Integer">
        SELECT MAX(sequence) FROM auction_pick_record WHERE sessionId = #{sessionId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO auction_pick_record
        (sessionId, auctionId, playerId, teamId, amount, sequence, createTime)
        VALUES
        (#{sessionId}, #{auctionId}, #{playerId}, #{teamId}, #{amount}, #{sequence}, NOW())
    </insert>

    <delete id="deleteById">
        DELETE FROM auction_pick_record WHERE id = #{id}
    </delete>

    <delete id="deleteBySessionIdAndSequenceGte">
        DELETE FROM auction_pick_record
        WHERE sessionId = #{sessionId}
          AND sequence >= #{sequence}
    </delete>

    <delete id="deleteBySessionId">
        DELETE FROM auction_pick_record WHERE sessionId = #{sessionId}
    </delete>

    <select id="sumAmountByTeamId" resultType="java.math.BigDecimal">
        SELECT COALESCE(SUM(amount), 0)
        FROM auction_pick_record
        WHERE teamId = #{teamId}
    </select>

    <select id="selectByTeamIdAndPlayerId" resultMap="BaseResultMap">
        SELECT *
        FROM auction_pick_record
        WHERE teamId = #{teamId}
          AND playerId = #{playerId}
        ORDER BY sequence ASC, id ASC
    </select>

    <delete id="deleteByTeamIdAndPlayerId">
        DELETE FROM auction_pick_record
        WHERE teamId = #{teamId}
          AND playerId = #{playerId}
    </delete>

</mapper>

